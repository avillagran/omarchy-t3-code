#!/bin/bash
# Isolated QML integration checks; no live connections, accounts or Python runtime.
set -eu
task_template=${1:-composer}
case "$task_template" in provider-instances|settle-navigation|composer-enter|usage-limits|file-previews|storage-page|storage-settings|markdown-images|browser-import-logic|browser-import|browser-flow|browser-workspace|browser-surface|browser-page|preview-actions|preview-sessions|preview-state|browser-profiles|browser-preferences|integrations-preferences|integrations|licenses-preferences|licenses|script-shortcuts|keybindings-runtime|shortcut-routing|keybindings-flow|keybinding-row|keybindings-editor|keybindings-logic|archive-preferences|archive|checkpoint-diff-flow|diff-preferences|native-diff-flow|working-review-flow|checkpoint-flow|checkpoint-revert|git-controls|git-flow|plan-preference|plan-flow|plan-workflow|project-preferences|preferences-scope|activity-inspector|diff-review|tool-inspector|preferences-defaults|connection-routing|connection-cloud|connection-preferences|connection-network|connection-access|visual-parity|timeline-spacing|markdown-links|composer-overlay|sidebar-navigation|sidebar-anchor|thread-aura|reveal-transitions|shelf-resize|composer|sidebar|state|interaction|completion|layout|queue|tasks|editor|i18n|send-scroll|clipboard|work-details|live-media|scroll-stability|wheel-scroll|draft-undo|upward-scroll|model-picker|inertia|thread-hover|auto-compaction|questions|question-state|compact-sidebar|pull-requests|backend-start|documents|project-menu|thread-menu|content-panels|timeline|thread-menu-panel|backend-owner|dpi-lifecycle|sidebar-pr|panel-reopen|backend-reconnect|context-divider|copy-actions|window-mode|preferences|preferences-source-control|preferences-design|approvals|approval-state|history-find|project-picker|window-cycle|connections|creation-dialogs|send-new-thread|sidebar-order|project-open|permissions|native-terminal|code-actions|provider-subagent|inline-html|project-drafts|screenshot|row-motion|render-panel|side-panel|branch-fork|command-palette|diagram|secret-request|pr-actions|usage-page|scheduled-tasks|branch-mismatch|mcp-app) ;; *) echo 'Unknown QML check' >&2; exit 1;; esac
task_repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "$task_template" = shortcut-routing ] && [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  # This fixture focuses only its own PID before sending Qt test keys. A unique
  # compositor socket is required; never guess between desktop sessions.
  task_hypr_sockets=("${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/hypr/*/.socket.sock)
  if [ "${#task_hypr_sockets[@]}" -ne 1 ] || [ ! -S "${task_hypr_sockets[0]}" ]; then
    echo 'shortcut-routing requires an explicit HYPRLAND_INSTANCE_SIGNATURE' >&2
    exit 1
  fi
  HYPRLAND_INSTANCE_SIGNATURE=$(basename "$(dirname "${task_hypr_sockets[0]}")")
  export HYPRLAND_INSTANCE_SIGNATURE
fi
task_root=$(mktemp -d /tmp/t3-qml-test-XXXXXX)
trap 'rm -rf -- "$task_root"' EXIT
for task_dir in Commons Ui plugins services; do ln -s "/usr/share/omarchy/shell/$task_dir" "$task_root/$task_dir"; done
ln -s "$task_repo" "$task_root/UnderTest"
cp "$task_repo/tests/qml/$task_template.qml" "$task_root/shell.qml"
if [ "$task_template" = state ]; then
  mkdir -p "$task_root/state/omarchy-t3-code"
  printf '%s\n' '{"schemaVersion":1,"quotaCollapsed":true,"selectedEnvironment":"fixture","selectedThread":"restored","positions":{}}' > "$task_root/state/omarchy-t3-code/ui-state.json"
fi
mkdir -p "$task_root/bin"
if [ "$task_template" = code-actions ]; then
  printf '%s\n' '#!/bin/sh' 'cat > /dev/null' > "$task_root/bin/wl-copy"
  chmod 700 "$task_root/bin/wl-copy"
fi
if [ "$task_template" = clipboard ]; then
  cat > "$task_root/bin/wl-paste" <<'CLIP'
#!/bin/sh
if [ "$1" = --list-types ]; then printf '%s\n' text/plain; else printf '%s' 'pasted text'; fi
CLIP
  chmod 700 "$task_root/bin/wl-paste"
fi
env -u KIMI_CODING_API_KEY -u OPENCODE_API_KEY -u OPENCODE_GO_API_KEY -u OMARCHY_T3_FIXTURE_ENVIRONMENTS PATH="$task_root/bin:$PATH" OMARCHY_T3_LANGUAGE=es HOME="$task_root/home" XDG_CONFIG_HOME="$task_root/config" XDG_STATE_HOME="$task_root/state" XDG_DATA_HOME="$task_root/data" T3CODE_HOME="$task_root/native" timeout 12 quickshell -p "$task_root/shell.qml" > "$task_root/log" 2>&1 || { cat "$task_root/log"; exit 1; }
if rg 'QML_FAIL|ReferenceError|TypeError|Binding loop' "$task_root/log"; then cat "$task_root/log"; exit 1; fi
rg 'QML_PASS' "$task_root/log" || { cat "$task_root/log"; exit 1; }
