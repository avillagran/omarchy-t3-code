#!/bin/bash
# Isolated QML integration checks; no live connections, accounts or Python runtime.
set -eu
task_template=${1:-composer}
case "$task_template" in mosaic-replies|mosaic-phases|row-click|sidebar-search|mosaic-motion|provider-instances|settle-navigation|composer-enter|usage-limits|file-previews|storage-page|storage-settings|journal-settings|disk-space|build-cleanup|markdown-images|browser-import-logic|browser-import|browser-flow|browser-workspace|browser-surface|browser-page|preview-actions|preview-sessions|preview-state|browser-profiles|browser-preferences|integrations-preferences|integrations|licenses-preferences|licenses|script-shortcuts|keybindings-runtime|shortcut-routing|keybindings-flow|keybinding-row|keybindings-editor|keybindings-logic|archive-preferences|archive|checkpoint-diff-flow|diff-preferences|native-diff-flow|working-review-flow|checkpoint-flow|checkpoint-revert|git-controls|git-flow|plan-preference|plan-flow|plan-workflow|project-preferences|preferences-scope|activity-inspector|diff-review|tool-inspector|preferences-defaults|connection-routing|connection-cloud|connection-preferences|connection-network|connection-access|visual-parity|timeline-spacing|markdown-links|composer-overlay|sidebar-navigation|sidebar-anchor|thread-aura|reveal-transitions|shelf-resize|composer|sidebar|state|interaction|completion|layout|queue|tasks|editor|i18n|send-scroll|clipboard|work-details|live-media|scroll-stability|wheel-scroll|draft-undo|upward-scroll|model-picker|inertia|thread-hover|auto-compaction|questions|question-state|compact-sidebar|pull-requests|backend-start|documents|project-menu|thread-menu|content-panels|timeline|thread-menu-panel|backend-owner|dpi-lifecycle|sidebar-pr|panel-reopen|backend-reconnect|context-divider|copy-actions|window-mode|preferences|preferences-source-control|preferences-design|approvals|approval-state|history-find|project-picker|window-cycle|connections|creation-dialogs|send-new-thread|sidebar-order|project-open|permissions|native-terminal|code-actions|provider-subagent|subagent-lineage|thread-details|failure-context|hosts-popup|inline-html|project-drafts|screenshot|dictation|row-motion|render-panel|side-panel|branch-fork|command-palette|diagram|secret-request|pr-actions|usage-page|scheduled-tasks|branch-mismatch|mcp-app|provider-setup|qml-preview|connection-omabridge|omabridge-manage|omabridge-install|prompted-chat|omabridge-indicator|row-recycling|server-updates|appearance) ;; *) echo 'Unknown QML check' >&2; exit 1;; esac
task_repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "$task_template" = shortcut-routing ] && [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  # This fixture focuses only its own PID before sending Qt test keys. A unique
  # compositor socket is required; never guess between desktop sessions.
  task_hypr_sockets=("${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/hypr/*/.socket.sock)
  if [ "${#task_hypr_sockets[@]}" -ne 1 ] || [ ! -S "${task_hypr_sockets[0]}" ]; then
    echo 'shortcut-routing requires an explicit HYPRLAND_INSTANCE_SIGNATURE' >&2
    exit 1
  fi
  HYPRLAND_INSTANCE_SIGNATURE=$(basename "$(dirname "${task_hypr_sockets[0]}")")
  export HYPRLAND_INSTANCE_SIGNATURE
fi
# QML previews wait out the renderer's 4 s endless-loop watchdog.
task_timeout=12;case "$task_template" in qml-preview|mosaic-motion) task_timeout=24;; esac
task_root=$(mktemp -d /tmp/t3-qml-test-XXXXXX)
trap 'rm -rf -- "$task_root"' EXIT
for task_dir in Commons Ui plugins services; do ln -s "/usr/share/omarchy/shell/$task_dir" "$task_root/$task_dir"; done
ln -s "$task_repo" "$task_root/UnderTest"
{ printf '%s\n' '//@ pragma OmarchyLoadPatch' '//@ pragma RespectSystemStyle'; cat "$task_repo/tests/qml/$task_template.qml"; } > "$task_root/shell.qml"
# The app's Controls style, as bin/ot3 selects it.
QT_QUICK_CONTROLS_STYLE=OmarchyT3; QML_IMPORT_PATH="$task_root/UnderTest/ui/style"; export QT_QUICK_CONTROLS_STYLE QML_IMPORT_PATH
if [ "$task_template" = appearance ]; then
  # A theme Omarchy already applied, and the shared tooltip preferences.
  mkdir -p "$task_root/home/.local/state/omarchy/current/theme" "$task_root/config/omarchy"
  printf '%s\n' 'accent = "#111111"' 'blue = "#1111aa"' > "$task_root/home/.local/state/omarchy/current/theme/colors.toml"
  printf '%s\n' first > "$task_root/home/.local/state/omarchy/current/theme.name"
  printf '%s\n' '{"shape":"square","borderMode":"custom","borderColor":"#ff0000"}' > "$task_root/config/omarchy/tooltips.json"
fi
if [ "$task_template" = state ]; then
  mkdir -p "$task_root/state/omarchy-t3-code"
  printf '%s\n' '{"schemaVersion":1,"quotaCollapsed":true,"selectedEnvironment":"fixture","selectedThread":"restored","positions":{}}' > "$task_root/state/omarchy-t3-code/ui-state.json"
fi
mkdir -p "$task_root/bin"
if [ "$task_template" = dictation ]; then
  # A stand-in for bin/ot3-dictate: no microphone, no model.
  mkdir -p "$task_root/home"
  cat > "$task_root/bin/ot3-dictate" <<'DICTATE'
#!/bin/sh
case "$1" in
  models) small=false; [ -f "$HOME/small-installed" ] && small=true
    printf '{"models":[{"id":"base","sizeBytes":1000,"installed":true},{"id":"small","sizeBytes":2000,"installed":%s}],"default":"base","recorder":true}\n' "$small";;
  download) printf '%s\n' '{"type":"progress","bytes":1000,"total":2000}'; : > "$HOME/small-installed"; printf '%s\n' '{"type":"done","model":"small"}';;
  listen) trap 'printf "%s\n" "{\"type\":\"transcribing\"}" "{\"type\":\"text\",\"text\":\"hola mundo\",\"language\":\"es\",\"seconds\":1,\"elapsedMs\":5}"; exit 0' INT
    trap 'exit 130' TERM
    printf '%s\n' '{"type":"recording"}' '{"type":"level","value":0.2}' '{"type":"level","value":0.2}' '{"type":"level","value":0.8}'
    while :; do sleep 0.05; done;;
  recordings) printf '%s\n' '{"recordings":[{"id":"1700000000000","file":"/tmp/ot3-dictation-fixture/1700000000000.wav","time":1700000000000,"seconds":2.5,"text":"hola mundo"}]}';;
  delete|forget|prune) printf '%s\n' '{"type":"ok"}';;
esac
DICTATE
  chmod 700 "$task_root/bin/ot3-dictate"
  OMARCHY_T3_DICTATE="$task_root/bin/ot3-dictate"; export OMARCHY_T3_DICTATE
fi
if [ "$task_template" = code-actions ]; then
  printf '%s\n' '#!/bin/sh' 'cat > /dev/null' > "$task_root/bin/wl-copy"
  chmod 700 "$task_root/bin/wl-copy"
fi
if [ "$task_template" = clipboard ]; then
  cat > "$task_root/bin/wl-paste" <<'CLIP'
#!/bin/sh
if [ "$1" = --list-types ]; then printf '%s\n' text/plain; else printf '%s' 'pasted text'; fi
CLIP
  chmod 700 "$task_root/bin/wl-paste"
fi
env -u KIMI_CODING_API_KEY -u OPENCODE_API_KEY -u OPENCODE_GO_API_KEY -u OMARCHY_T3_FIXTURE_ENVIRONMENTS PATH="$task_root/bin:$PATH" OMARCHY_T3_LANGUAGE=es HOME="$task_root/home" XDG_CONFIG_HOME="$task_root/config" XDG_STATE_HOME="$task_root/state" XDG_DATA_HOME="$task_root/data" T3CODE_HOME="$task_root/native" timeout "$task_timeout" quickshell -p "$task_root/shell.qml" > "$task_root/log" 2>&1 || { cat "$task_root/log"; exit 1; }
if rg 'QML_FAIL|ReferenceError|TypeError|Binding loop' "$task_root/log"; then cat "$task_root/log"; exit 1; fi
rg 'QML_PASS' "$task_root/log" || { cat "$task_root/log"; exit 1; }
