#!/usr/bin/env python3
"""Bundle the pinned whole consent producers in a private build container."""
import argparse
import hashlib
import json
import os
import pathlib
import stat
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
for name in ['native', 'dependencies', 'compiler', 'node']:
    parser.add_argument('--' + name, required=True, type=pathlib.Path)
args = parser.parse_args()
root = pathlib.Path(__file__).resolve().parent.parent
revision = '83a3674ffd84ffb33de768210c806cb1ac53fd80'
assert subprocess.check_output(['git', '-C', str(args.native), 'rev-parse', 'HEAD'], text=True).strip() == revision
assert subprocess.check_output(['podman', '--remote=false', 'info', '--format', '{{.Host.Security.Rootless}}'], text=True).strip() == 'true'
node = args.node.resolve(strict=True)
with node.open('rb') as executable:
    before = os.fstat(executable.fileno())
    assert stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and before.st_mode & 0o111 and not before.st_mode & 0o222
    assert hashlib.file_digest(executable, 'sha256').hexdigest() == '0adde40d1b7dfa57c8bc83cbc319758c3ec6ebba21363bb2fa752ea6b267ad1b'
    assert before == os.fstat(executable.fileno())
evidence = pathlib.Path(tempfile.mkdtemp(prefix='native-consent-build-', dir='/var/tmp/o3-build'))
evidence.chmod(0o700)
source = evidence / 'native'
source.mkdir(mode=0o700)
names = ['apps/web/src/speech/voiceConsent.ts', 'apps/web/src/hooks/useLocalStorage.ts', 'apps/web/src/lib/utils.ts', 'packages/contracts/src/baseSchemas.ts', 'packages/contracts/src/speech.ts', 'packages/contracts/src/settings.ts']
source_hashes = {}
for name in names:
    data = (args.native / name).read_bytes()
    assert data == subprocess.check_output(['git', '-C', str(args.native), 'show', revision + ':' + name])
    target = source / name
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)
    target.chmod(0o400)
    source_hashes[name] = hashlib.sha256(data).hexdigest()
(source / 'REVISION').write_text(revision + '\n')
(source / 'REVISION').chmod(0o400)
output = evidence / 'output'
(output / 'tools').mkdir(parents=True)
(output / 'ui/voice').mkdir(parents=True)
generator = 'tools/build-native-voice-consent.mjs'
(output / generator).write_bytes((root / generator).read_bytes())
(output / generator).chmod(0o400)
state = evidence / 'state'
for name in ['home', 'tmp', 'config', 'cache', 'data', 'runtime']:
    (state / name).mkdir(mode=0o700, parents=True)
command = ['podman', '--remote=false', 'run', '--rm', '--pull=never', '--userns=keep-id', '--user', f'{os.getuid()}:{os.getgid()}', '--read-only', '--network=none', '--cap-drop=ALL', '--security-opt=no-new-privileges', '--pids-limit=64', '--memory=1g', '--ulimit', 'core=0', '--workdir', '/output', '-v', f'{source}:/native:ro', '-v', f'{args.dependencies.resolve()}:/dependencies:ro', '-v', f'{args.compiler.resolve()}:/compiler:ro', '-v', f'{node}:/voice-node:ro', '-v', f'{output}:/output:rw', '-v', f'{state}:/state:rw', '-v', '/usr:/usr:ro', '--env', 'HOME=/state/home', '--env', 'TMPDIR=/state/tmp', '--env', 'XDG_CONFIG_HOME=/state/config', '--env', 'XDG_CACHE_HOME=/state/cache', '--env', 'XDG_DATA_HOME=/state/data', '--env', 'XDG_RUNTIME_DIR=/state/runtime', 'localhost/o3-rust-tests:latest', '/voice-node', '/output/' + generator, '/native', '/dependencies', '/compiler']
with (evidence / 'build.log').open('w') as log:
    result = subprocess.run(command, stdout=log, stderr=subprocess.STDOUT, timeout=90)
receipt = {'exit': result.returncode, 'revision': revision, 'sourceSha256': source_hashes, 'scope': 'Build only; no consent runtime or consumer activation claim'}
if result.returncode == 0:
    receipt['outputs'] = {}
    for name in ['ui/voice/native-consent.cjs', 'ui/voice/native-consent.sources.json']:
        data = (output / name).read_bytes()
        (root / name).write_bytes(data)
        receipt['outputs'][name] = hashlib.sha256(data).hexdigest()
(evidence / 'result.json').write_text(json.dumps(receipt, indent=2) + '\n')
print(evidence)
raise SystemExit(result.returncode)
