#!/usr/bin/env python3
"""Check real package input through read-only mounts without duplicating Electron."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile
import native_voice_bundle as voice

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--runtime', type=Path, required=True)
parser.add_argument('--addon', type=Path, required=True)
parser.add_argument('--client', type=Path,
    help='optional coordinated build whose embedded pins match this addon')
args = parser.parse_args()
podman = ['podman', '--remote=false']
assert subprocess.check_output([*podman, 'info', '--format',
    '{{.Host.Security.Rootless}}'], text=True).strip() == 'true'
runtime = voice.directory(args.runtime)
addon = voice.canonical(args.addon)
receipt = voice.metadata_tool.prepare(addon, voice.ROOT)
out = Path(tempfile.mkdtemp(prefix='native-voice-package-', dir='/var/tmp/o3-build'))
out.chmod(0o700)
package = out / 'package'
package.mkdir(mode=0o700)
binary_dir = package / 'bin'
binary_dir.mkdir(mode=0o700)
bundle = binary_dir / 'native-voice'
bundle.mkdir(mode=0o700)
(bundle / voice.RUNTIME).mkdir(mode=0o700)
(bundle / voice.ADDON).write_bytes(b'')
(bundle / voice.ADDON).chmod(0o400)
(bundle / voice.RECEIPT).write_text(json.dumps(receipt, sort_keys=True) + '\n')
(bundle / voice.RECEIPT).chmod(0o400)
(bundle / voice.LICENSE).write_bytes((voice.ROOT / 'LICENSE').read_bytes())
(bundle / voice.LICENSE).chmod(0o400)
files = ['tools/test-native-voice-package', 'tools/native_voice_bundle.py',
    'tools/prepare-native-voice-build-metadata', 'tools/fixtures/native-voice-package.py',
    'ui/voice/electron-runtime-44.10.1-linux-x64.json', 'ui/browser/electron-private-fd.c', 'LICENSE']
digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()
fence = {name: digest(voice.ROOT / name) for name in files}
image = subprocess.check_output([*podman, 'image', 'inspect', 'docker.io/library/archlinux:latest',
    '--format', '{{.Id}}'], text=True).strip()
if len(image) == 64:
    image = 'sha256:' + image
assert image.startswith('sha256:') and len(image) == 71
command = [*podman, 'run', '--rm', '--init', '--timeout=100', '--pull=never',
    '--http-proxy=false', '--read-only', '--network=none', '--userns=keep-id',
    '--user', f'{os.getuid()}:{os.getgid()}', '--cap-drop=ALL',
    '--security-opt=no-new-privileges', '--memory=512m', '--pids-limit=32', '--ulimit=core=0:0',
    '--tmpfs', '/tmp:rw,size=16m,mode=1777', '-v', '/usr:/usr:ro',
    '-v', f'{voice.ROOT}:/repo:ro', '-v', f'{package}:/package:ro',
    '-v', f'{runtime}:/package/bin/native-voice/{voice.RUNTIME}:ro',
    '-v', f'{addon}:/package/bin/native-voice/{voice.ADDON}:ro',
    '--env', 'PYTHONDONTWRITEBYTECODE=1']
if args.client:
    client = voice.canonical(args.client)
    for name in ['src/main.rs', 'src/voice_host.rs', 'src/voice_host/resource_discovery.rs',
            'src/voice_capture/resources.rs', 'Cargo.toml', 'Cargo.lock']:
        fence[name] = digest(voice.ROOT / name)
    client_sha256 = digest(client)
    (binary_dir / 'omarchy-t3-client').write_bytes(b'')
    command += ['-v', f'{client}:/package/bin/omarchy-t3-client:ro']
command += [image, '/usr/bin/python3', '/repo/tools/fixtures/native-voice-package.py']
if args.client:
    command += ['--client']
with (out / 'runtime.json').open('w') as stdout, (out / 'runtime.log').open('w') as stderr:
    result = subprocess.run(command, stdout=stdout, stderr=stderr, timeout=115)
proof = {'exit': result.returncode, 'sourceSha256': fence, 'imageId': image,
    'compiledClientRequested': args.client is not None}
if args.client:
    assert digest(client) == client_sha256
    proof['clientSha256'] = client_sha256
    proof['clientBytes'] = client.stat().st_size
if result.returncode == 0:
    proof['receipt'] = json.loads((out / 'runtime.json').read_text())
assert all(digest(voice.ROOT / name) == value for name, value in fence.items())
(out / 'result.json').write_text(json.dumps(proof, indent=2) + '\n')
print(out)
raise SystemExit(result.returncode)
