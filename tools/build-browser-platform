#!/bin/bash
# Build the GUI member without installing or touching desktop configuration.
set -eu
cd -- "$(dirname -- "$0")/.."
task_build_root="${O3_BROWSER_PLATFORM_BUILD_ROOT:-/var/tmp}"
mkdir -p -- "$task_build_root"
task_build_dir="$(mktemp -d "$task_build_root/o3-browser-platform-XXXXXXXX")"
exec 9>/var/tmp/o3-build/o3-parity-compile.lock
flock 9
task_moc="$(pkg-config --variable=libexecdir Qt6Core)/moc"
"$task_moc" native/browser/clipboardplatform.h -o "$task_build_dir/moc_clipboardplatform.cpp"
"$task_moc" native/browser/plugin.cpp -o "$task_build_dir/plugin.moc"
c++ -std=c++17 -Os -Wall -Wextra -Werror -fPIC -fvisibility=hidden -shared native/browser/clipboardplatform.cpp native/browser/clipboardcohort.cpp native/browser/plugin.cpp "$task_build_dir/moc_clipboardplatform.cpp" -Inative/browser -I"$task_build_dir" -o "$task_build_dir/libo3browserplatform.so" $(pkg-config --cflags --libs Qt6Qml Qt6Gui wayland-client xcb xcb-xfixes xcb-res)
mkdir -p bin/qml/O3/Browser
cp "$task_build_dir/libo3browserplatform.so" bin/qml/O3/Browser/libo3browserplatform.so.next
mv bin/qml/O3/Browser/libo3browserplatform.so.next bin/qml/O3/Browser/libo3browserplatform.so
cp native/browser/qmldir bin/qml/O3/Browser/qmldir
printf 'Browser platform plugin: %s\n' "$PWD/bin/qml/O3/Browser/libo3browserplatform.so"
