#!/bin/bash
# Build/test-only Node harness over the private Qt renderer protocol. All pages,
# cookies and storage below are isolated fixtures; no user's browser is opened.
set -eu
cd -- "$(dirname -- "$0")/.."
node <<'NODE_BROWSER_TEST'
const fs=require('node:fs'),os=require('node:os'),path=require('node:path'),http=require('node:http'),{spawn}=require('node:child_process'),assert=require('node:assert/strict'),crypto=require('node:crypto');
const root=fs.mkdtempSync(path.join(os.tmpdir(),'ot3-browser-test-'));fs.chmodSync(root,0o700);fs.mkdirSync(path.join(root,'runtime'),{mode:0o700});
const wait=ms=>new Promise(r=>setTimeout(r,ms));let serial=0;const children=[],requests=[];
const server=http.createServer((req,res)=>{requests.push({url:req.url,cookie:req.headers.cookie || ''});res.setHeader('Content-Type','text/html');res.end('<!doctype html><title>'+req.url+'</title><style>body{margin:0;background:#203040;color:white}button{width:160px;height:80px}</style><button onclick="this.innerText=\'Clicked\';document.body.style.background=\'green\'">Click</button><p>'+req.url+'</p>');});
function launch(profile='default',environment='fixture'){
 const child=spawn('bin/omarchy-t3-client',['browser-render'],{env:{PATH:process.env.PATH,LANG:process.env.LANG || 'C.UTF-8',DBUS_SESSION_BUS_ADDRESS:'unix:path='+path.join(root,'no-session-bus'),XDG_RUNTIME_DIR:path.join(root,'runtime'),T3CODE_HOME:path.join(root,'native'),HOME:path.join(root,'home'),XDG_CACHE_HOME:path.join(root,'cache'),XDG_CONFIG_HOME:path.join(root,'config'),XDG_DATA_HOME:path.join(root,'data'),XDG_STATE_HOME:path.join(root,'state'),QT_QPA_PLATFORM:'offscreen',QT_QUICK_BACKEND:'software',QTWEBENGINE_CHROMIUM_FLAGS:'--disable-gpu --password-store=basic',QT_SCALE_FACTOR:'1',QT_SCREEN_SCALE_FACTORS:'1'},stdio:['pipe','pipe','pipe']});
 const runtime={child,events:[],log:'',out:'',exit:null,closed:false};children.push(runtime);
 child.stdout.on('data',bytes=>{runtime.out+=bytes;let n;while((n=runtime.out.indexOf('\n'))>=0){const row=runtime.out.slice(0,n);runtime.out=runtime.out.slice(n+1);try{runtime.events.push(JSON.parse(row))}catch{}}});child.stderr.on('data',bytes=>runtime.log+=bytes);child.on('exit',code=>{runtime.exit=code;runtime.closed=true});child.stdin.on('error',()=>{});
 const data=Buffer.from(JSON.stringify({environmentId:environment,profileId:profile,width:640,height:400})),header=Buffer.alloc(8);header.writeBigUInt64BE(BigInt(data.length));child.stdin.write(header);child.stdin.write(data);return runtime;
}
function send(r,v){r.child.stdin.write(JSON.stringify(v)+'\n')}
async function until(r,check,timeout=8000){const end=Date.now()+timeout;while(Date.now()<end){const value=check();if(value)return value;assert(!r.closed,'Qt runtime exited: '+r.log);await wait(30)}throw Error('Qt runtime timeout: '+r.log)}
async function ready(r){const event=await until(r,()=>r.events.find(e=>e.type==='ready'));assert(event.frameDirectory.startsWith(path.join(root,'cache')));return event}
async function open(r,tab,url){const start=r.events.length;send(r,{type:'open',threadId:'thread',tabId:tab,url});await until(r,()=>r.events.slice(start).find(e=>e.type==='status'&&e.tabId===tab&&e.navStatus._tag==='Success'&&e.navStatus.url===url));}
async function navigate(r,tab,type,url,expected=url){const start=r.events.length;send(r,{type,threadId:'thread',tabId:tab,url});return await until(r,()=>r.events.slice(start).find(e=>e.type==='status'&&e.tabId===tab&&e.navStatus._tag==='Success'&&e.navStatus.url===expected));}
async function evaluate(r,tab,script){const id='eval-'+(++serial);send(r,{type:'evaluate',threadId:'thread',tabId:tab,requestId:id,script});return (await until(r,()=>r.events.find(e=>e.type==='evaluation'&&e.requestId===id))).value;}
async function close(r){send(r,{type:'close'});const until=Date.now()+6000;while(!r.closed&&Date.now()<until)await wait(30);assert(r.closed,'runtime did not flush/close');assert.equal(r.exit,0,r.log);}
(async()=>{try{
 await new Promise(resolve=>server.listen(0,'127.0.0.1',resolve));const base='http://127.0.0.1:'+server.address().port;
 const first=launch();const init=await ready(first);await open(first,'one',base+'/a');assert.equal(await evaluate(first,'one','document.title'),'/a');await navigate(first,'one','navigate',base+'/c');await navigate(first,'one','back',undefined,base+'/a');await navigate(first,'one','forward',undefined,base+'/c');await navigate(first,'one','back',undefined,base+'/a');
 await evaluate(first,'one','localStorage.setItem("persisted","yes");document.cookie="fixture=yes; path=/; max-age=3600";"set"');
 send(first,{type:'import-cookie',requestId:'import-http-only',cookie:{url:base+'/',name:'httpOnlyFixture',value:'not-for-page',path:'/',httpOnly:true,secure:false,expirationDate:Math.floor(Date.now()/1000)+3600}});
 const imported=await until(first,()=>first.events.find(e=>e.type==='cookie-imported'&&e.requestId==='import-http-only'));assert.equal(imported.state,'complete',JSON.stringify(imported));send(first,{type:'import-cookie',requestId:'invalid-cookie',cookie:{url:'file:///tmp/private',name:'bad',value:'never-emitted'}});const invalid=await until(first,()=>first.events.find(e=>e.type==='cookie-imported'&&e.requestId==='invalid-cookie'));assert.equal(invalid.state,'failed');assert.equal(invalid.error,'invalid_browser_cookie');assert(!(await evaluate(first,'one','document.cookie')).includes('httpOnlyFixture'));
 assert.equal(await evaluate(first,'one','[typeof browserHost,typeof browserProfile,typeof require,typeof process].join(",")'),'undefined,undefined,undefined,undefined');await navigate(first,'one','navigate',base+'/after-import');assert(requests.find(r=>r.url==='/after-import').cookie.includes('httpOnlyFixture=not-for-page'));assert(!JSON.stringify(first.events).includes('not-for-page'),'HTTP-only cookie values must not be emitted');
 await open(first,'two',base+'/b');assert.equal(await evaluate(first,'two','localStorage.getItem("persisted")'), 'yes');assert((await evaluate(first,'two','document.cookie')).includes('fixture=yes'));
 send(first,{type:'activate',threadId:'thread',tabId:'one'});await wait(120);const frames=first.events.filter(e=>e.type==='frame');assert(frames.length);const framePath=path.join(init.frameDirectory,frames.at(-1).file);assert.equal(fs.statSync(framePath).mode&0o777,0o600);const before=crypto.createHash('sha256').update(fs.readFileSync(framePath)).digest('hex');send(first,{type:'press',x:60,y:40,button:1,buttons:1,modifiers:0});send(first,{type:'release',x:60,y:40,button:1,buttons:0,modifiers:0});await wait(250);assert.equal(await evaluate(first,'one','document.querySelector("button").innerText'),'Clicked');await wait(120);const latest=first.events.filter(e=>e.type==='frame').at(-1);assert.notEqual(crypto.createHash('sha256').update(fs.readFileSync(path.join(init.frameDirectory,latest.file))).digest('hex'),before,'browser repaint delivered');send(first,{type:'navigate',threadId:'thread',tabId:'one',url:'javascript:document.title="injected"'});await wait(70);assert.equal(await evaluate(first,'one','document.title'),'/after-import');send(first,{type:'navigate',threadId:'thread',tabId:'one',url:'slack://open?fixture=1'});await until(first,()=>first.events.find(e=>e.type==='external-protocol'&&e.url.startsWith('slack:')));assert(!first.events.some(e=>e.type==='external-protocol'&&e.url.startsWith('javascript:')));send(first,{type:'close-tab',threadId:'thread',tabId:'two'});await until(first,()=>first.events.find(e=>e.type==='closed'&&e.tabId==='two'));assert.equal(await evaluate(first,'one','document.querySelector("button").innerText'),'Clicked');
 send(first,{type:'resize',width:720,height:480});await until(first,()=>first.events.some(e=>e.type==='frame'&&e.width===720&&e.height===480));assert.equal(await evaluate(first,'one','window.innerWidth'),720);send(first,{type:'resize',width:3840,height:3840});await wait(160);assert.equal(first.events.filter(e=>e.type==='frame').at(-1).width,720);await wait(350);const idleFrames=first.events.filter(e=>e.type==='frame').length;await wait(350);assert.equal(first.events.filter(e=>e.type==='frame').length,idleFrames,'idle browser must not capture continuously');
 const second=launch('work');await ready(second);await open(second,'work',base+'/work');assert.equal(await evaluate(second,'work','document.cookie'),'');assert(!requests.find(r=>r.url==='/work').cookie.includes('httpOnlyFixture'));assert.equal(await evaluate(second,'work','localStorage.getItem("persisted")'),null);
 const other=launch('default','other-environment');await ready(other);await open(other,'other',base+'/other');assert.equal(await evaluate(other,'other','document.cookie'),'');assert(!requests.find(r=>r.url==='/other').cookie.includes('httpOnlyFixture'));
 await close(second);await close(other);await close(first);
 const reopened=launch();await ready(reopened);await open(reopened,'restored',base+'/restored');assert((await evaluate(reopened,'restored','document.cookie')).includes('fixture=yes'));assert.equal(await evaluate(reopened,'restored','localStorage.getItem("persisted")'),'yes');assert(requests.find(r=>r.url==='/restored').cookie.includes('httpOnlyFixture=not-for-page'));await close(reopened);
 const privateOne=launch('incognito');await ready(privateOne);await open(privateOne,'private',base+'/private');assert.equal(await evaluate(privateOne,'private','document.cookie'),'');await evaluate(privateOne,'private','localStorage.setItem("incognito","secret");document.cookie="private=yes; path=/; max-age=3600";"set"');await close(privateOne);
 const privateTwo=launch('incognito');await ready(privateTwo);await open(privateTwo,'private',base+'/private');assert.equal(await evaluate(privateTwo,'private','document.cookie'),'');assert.equal(await evaluate(privateTwo,'private','localStorage.getItem("incognito")'),null);await close(privateTwo);
 console.log('BROWSER_VIEWER_PASS: real Qt navigation/input/frames, shared tabs, profile/environment isolation, persistent restart, incognito, HttpOnly import/scope, no page-native bridge, external protocol admission and shutdown');
 }catch(error){console.error(error);process.exitCode=1}finally{for(const r of children)if(!r.closed)r.child.kill('SIGKILL');await new Promise(resolve=>server.close(resolve));fs.rmSync(root,{recursive:true,force:true});}})();
NODE_BROWSER_TEST
