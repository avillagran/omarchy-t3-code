#!/usr/bin/env python3
"""Compile the resource admission example; execute only inside private Podman."""
import argparse,fcntl,hashlib,json,os,pathlib,subprocess,tempfile
p=argparse.ArgumentParser(description=__doc__);p.add_argument('--runtime',required=True,type=pathlib.Path);p.add_argument('--target',required=True,type=pathlib.Path);a=p.parse_args()
assert a.target.is_absolute()
root=pathlib.Path(__file__).resolve().parent.parent
assert subprocess.check_output(['podman','--remote=false','info','--format','{{.Host.Security.Rootless}}'],text=True).strip()=='true'
out=pathlib.Path(tempfile.mkdtemp(prefix='voice-capture-resources-',dir='/var/tmp/o3-build'));out.chmod(0o700)
files=['tools/test-voice-capture-resources','examples/voice_capture_resources.rs','src/voice_capture/resources.rs','ui/voice/electron-runtime-44.10.1-linux-x64.json','ui/voice/electron-capture-main.cjs','ui/voice/electron-capture-preload.cjs','ui/voice/electron-capture-renderer.mjs','ui/voice/browser-capture-owner.mjs','ui/js/NativePcmCapture.js','ui/browser/electron-private-fd.c','Cargo.toml','Cargo.lock']
fence={name:hashlib.sha256((root/name).read_bytes()).hexdigest()for name in files}
env={**os.environ,'CARGO_TARGET_DIR':str(a.target),'CARGO_BUILD_JOBS':'2'}
source=out/'source';source.mkdir(mode=0o700)
with pathlib.Path('/var/tmp/o3-build/o3-parity-compile.lock').open('a')as lock:
 fcntl.flock(lock,fcntl.LOCK_EX)
 with(out/'compile.jsonl').open('w')as output,(out/'compile.log').open('w')as log:compiled=subprocess.run(['cargo','build','--locked','--offline','--example','voice_capture_resources','--message-format=json'],cwd=root,env=env,stdout=output,stderr=log)
 if compiled.returncode:print(out);raise SystemExit(compiled.returncode)
 rows=[json.loads(line)for line in(out/'compile.jsonl').read_text().splitlines()];binaries=[row['executable']for row in rows if row.get('executable')and row.get('target',{}).get('name')=='voice_capture_resources'and row['target']['kind']==['example']];assert len(binaries)==1
 binary=source/'resource-check';binary.write_bytes(pathlib.Path(binaries[0]).read_bytes());binary.chmod(0o500)
 with(out/'strict.log').open('w')as log:strict=subprocess.run(['cargo','clippy','--locked','--offline','--example','voice_capture_resources','--','-D','warnings'],cwd=root,env=env,stdout=log,stderr=subprocess.STDOUT)
 if strict.returncode:print(out);raise SystemExit(strict.returncode)
 with(out/'addon.log').open('w')as log:subprocess.run(['cc','-shared','-fPIC','-O2','-Wall','-Wextra','-Werror','-I/usr/include/node',str(root/'ui/browser/electron-private-fd.c'),'-o',str(source/'electron-private-fd.node')],stdout=log,stderr=subprocess.STDOUT,check=True)
(source/'electron-private-fd.node').chmod(0o500)
state=out/'state';state.mkdir(mode=0o700)
command=['podman','--remote=false','run','--rm','--pull=never','--http-proxy=false','--read-only','--network=none','--userns=keep-id','--user',f'{os.getuid()}:{os.getgid()}','--cap-drop=ALL','--security-opt=no-new-privileges','--memory=512m','--pids-limit=32','--ulimit=core=0:0','--tmpfs','/tmp:rw,size=16m,mode=1777','-v','/usr:/usr:ro','-v',f'{a.runtime.resolve()}:/electron:ro','-v',f'{source}:/source:ro','-v',f'{state}:/state:rw','--env','HOME=/state','docker.io/library/archlinux:latest','/source/resource-check']
with(out/'runtime.json').open('w')as output,(out/'runtime.log').open('w')as log:result=subprocess.run(command,stdout=output,stderr=log,timeout=30)
assert all(hashlib.sha256((root/name).read_bytes()).hexdigest()==digest for name,digest in fence.items())
proof={'exit':result.returncode,'strictExit':strict.returncode,'sourceSha256':fence,'binarySha256':hashlib.sha256(binary.read_bytes()).hexdigest(),'scope':'Actual Rust runtime graph and small helper snapshot admission only; no process supervisor, audio or SDK acceptance'}
if result.returncode==0:proof['receipt']=json.loads((out/'runtime.json').read_text())
(out/'result.json').write_text(json.dumps(proof,indent=2)+'\n');print(out);raise SystemExit(proof['exit'])
