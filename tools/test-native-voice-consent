#!/usr/bin/env python3
"""Check whole native consent and physical private workers in a rootless container."""
import argparse
import fcntl
import hashlib
import json
import os
import pathlib
import subprocess
import tempfile

parser=argparse.ArgumentParser(description=__doc__)
for name in ['runtime','node','dependencies','build']:
    parser.add_argument('--'+name,required=True,type=pathlib.Path)
args=parser.parse_args()
root=pathlib.Path(__file__).resolve().parent.parent
assert subprocess.check_output(['podman','--remote=false','info','--format','{{.Host.Security.Rootless}}'],text=True).strip()=='true'
manifest=json.loads((root/'ui/voice/electron-runtime-44.10.1-linux-x64.json').read_text())
runtime=args.runtime.resolve(strict=True)
def verify_runtime():
    for member in manifest['files']:
        entry=runtime/member['path']
        assert entry.is_file()and not entry.is_symlink()and entry.stat().st_nlink==1
        assert entry.stat().st_size==member['bytes']
        with entry.open('rb')as file:
            assert hashlib.file_digest(file,'sha256').hexdigest()==member['sha256']
verify_runtime()
with args.node.open('rb')as file:
    assert hashlib.file_digest(file,'sha256').hexdigest()=='0adde40d1b7dfa57c8bc83cbc319758c3ec6ebba21363bb2fa752ea6b267ad1b'
evidence=pathlib.Path(tempfile.mkdtemp(prefix='native-consent-runtime-',dir='/var/tmp/o3-build'))
evidence.chmod(0o700)
source=evidence/'source'
source.mkdir(mode=0o700)
state=evidence/'state'
state.mkdir(mode=0o700)
files=['tools/test-native-voice-consent','tools/build-native-voice-consent','tools/build-native-voice-consent.mjs','tools/fixtures/consent-private.py','tools/fixtures/consent-traces.mjs','tools/fixtures/consent-native-loader.mjs','tools/fixtures/consent-bundle-traces.cjs','ui/voice/native-consent.cjs','ui/voice/native-consent.sources.json','ui/voice/consent-storage.cjs','ui/voice/consent-helper.cjs','ui/browser/electron-private-fd.c','ui/voice/electron-runtime-44.10.1-linux-x64.json']
fence={}
for name in files:
    data=(root/name).read_bytes()
    fence[name]=hashlib.sha256(data).hexdigest()
    target=source/pathlib.Path(name).name
    target.write_bytes(data)
    target.chmod(0o400)
metadata=json.loads((source/'native-consent.sources.json').read_text())
assert metadata['outputSha256']==fence['ui/voice/native-consent.cjs']
build=json.loads((args.build/'result.json').read_text())
assert build['exit']==0 and build['sourceSha256']==metadata['sourceFiles']
assert hashlib.sha256((args.build/'output/ui/voice/native-consent.cjs').read_bytes()).hexdigest()==metadata['outputSha256']
addon=source/'electron-private-fd.node'
with pathlib.Path('/var/tmp/o3-build/o3-parity-compile.lock').open('a')as lock:
    fcntl.flock(lock,fcntl.LOCK_EX)
    with(evidence/'compile.log').open('w')as log:
        compiled=subprocess.run(['cc','-shared','-fPIC','-O2','-Wall','-Wextra','-Werror','-I/usr/include/node',str(source/'electron-private-fd.c'),'-o',str(addon)],stdout=log,stderr=subprocess.STDOUT)
    assert compiled.returncode==0
addon.chmod(0o500)
command=['podman','--remote=false','run','--rm','--pull=never','--http-proxy=false','--timeout=85','--userns=keep-id','--user',f'{os.getuid()}:{os.getgid()}','--read-only','--network=none','--cap-drop=ALL','--security-opt=no-new-privileges','--memory=1g','--pids-limit=96','--ulimit=core=0:0','-v','/usr:/usr:ro','-v',f'{source}:/source:ro','-v',f'{state}:/state:rw','-v',f'{runtime}:/electron:ro','-v',f'{args.node.resolve()}:/voice-node:ro','-v',f'{args.dependencies.resolve()}:/dependencies:ro','-v',f'{args.build.resolve()}/output/oracle:/oracle:ro','docker.io/library/archlinux:latest','python3','/source/consent-private.py']
with(evidence/'runtime.log').open('w')as log:
    result=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,timeout=100)
proof={'exit':result.returncode,'sourceSha256':fence,'originalBuild':str(args.build.resolve()),'runtimeArchiveSha256':manifest['archiveSha256'],'scope':'Private native producer/storage/helper acceptance only; no Rust/UI/audio/SDK activation'}
if(state/'consent-proof.json').is_file():
    proof['receipt']=json.loads((state/'consent-proof.json').read_text())
assert all(hashlib.sha256((root/name).read_bytes()).hexdigest()==digest for name,digest in fence.items()),'Consent source changed during probe'
verify_runtime()
(evidence/'result.json').write_text(json.dumps(proof,indent=2)+'\n')
print(evidence)
raise SystemExit(result.returncode)
