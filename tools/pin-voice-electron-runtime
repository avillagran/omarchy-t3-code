#!/usr/bin/env python3
"""Pin every runtime member from the already admitted original Electron archive."""
import argparse,json,os,pathlib,subprocess,tempfile
p=argparse.ArgumentParser(description=__doc__);p.add_argument('--archive',required=True,type=pathlib.Path);a=p.parse_args()
root=pathlib.Path(__file__).resolve().parent.parent
assert subprocess.check_output(['podman','--remote=false','info','--format','{{.Host.Security.Rootless}}'],text=True).strip()=='true'
out=pathlib.Path(tempfile.mkdtemp(prefix='voice-runtime-pin-',dir='/var/tmp/o3-build'));out.chmod(0o700)
program=r"""
import hashlib,json,pathlib,stat,zipfile
archive=pathlib.Path('/archive.zip')
with archive.open('rb')as source:assert hashlib.file_digest(source,'sha256').hexdigest()=='2be868b71b0aa71f30e6b5567a106a35a049385e963183c074aad1975ead5167'
rows=[];names=set();total=0
with zipfile.ZipFile(archive)as original:
 for entry in original.infolist():
  name=pathlib.PurePosixPath(entry.filename);mode=entry.external_attr>>16
  assert not name.is_absolute()and name.parts and all(part not in ('.','..')for part in name.parts)and '\\'not in entry.filename
  assert entry.filename not in names;names.add(entry.filename)
  assert stat.S_IFMT(mode)in (0,stat.S_IFREG,stat.S_IFDIR)
  total+=entry.file_size;assert total<=1024*1024*1024 and entry.file_size<=512*1024*1024
  if entry.is_dir():continue
  digest=hashlib.sha256();size=0
  with original.open(entry)as source:
   while data:=source.read(1024*1024):digest.update(data);size+=len(data)
  assert size==entry.file_size
  rows.append({'path':str(name),'bytes':size,'sha256':digest.hexdigest(),'executable':bool(mode&0o111)})
assert len(rows)==72
print(json.dumps({'version':'44.10.1','platform':'linux-x64','archiveUrl':'https://github.com/electron/electron/releases/download/v44.10.1/electron-v44.10.1-linux-x64.zip','archiveSha256':'2be868b71b0aa71f30e6b5567a106a35a049385e963183c074aad1975ead5167','archiveBytes':archive.stat().st_size,'files':sorted(rows,key=lambda row:row['path'])},indent=2))
"""
command=['podman','--remote=false','run','--rm','--pull=never','--http-proxy=false','--read-only','--network=none','--userns=keep-id','--user',f'{os.getuid()}:{os.getgid()}','--cap-drop=ALL','--security-opt=no-new-privileges','--pids-limit=32','--memory=256m','--ulimit=core=0:0','--tmpfs','/tmp:rw,size=16m,mode=1777','-v','/usr:/usr:ro','-v',f'{a.archive.resolve()}:/archive.zip:ro','docker.io/library/archlinux:latest','python3','-c',program]
with(out/'manifest.json').open('w')as manifest,(out/'runtime.log').open('w')as log:result=subprocess.run(command,stdout=manifest,stderr=log,timeout=60)
assert result.returncode==0,out
value=json.loads((out/'manifest.json').read_text());assert len(value['files'])==72
(root/'ui/voice/electron-runtime-44.10.1-linux-x64.json').write_text(json.dumps(value,indent=2)+'\n')
print(out)
