#!/usr/bin/env python3
"""Build one actual Host facade example; execute synthetic capture only in private Podman."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import tempfile
p=argparse.ArgumentParser(description=__doc__)
for name in ['runtime','target']:p.add_argument('--'+name,type=Path,required=True)
a=p.parse_args();assert a.target.is_absolute()
root=Path(__file__).resolve().parent.parent
podman=['podman','--remote=false']
assert subprocess.check_output([*podman,'info','--format','{{.Host.Security.Rootless}}'],text=True).strip()=='true'
image=subprocess.check_output([*podman,'image','inspect','docker.io/library/archlinux:latest','--format','{{.Id}}'],text=True).strip()
if len(image)==64 and all(char in '0123456789abcdef' for char in image):image='sha256:'+image
assert image.startswith('sha256:') and len(image)==71
out=Path(tempfile.mkdtemp(prefix='voice-host-process-',dir='/var/tmp/o3-server'));out.chmod(0o700)
source=out/'source';source.mkdir(mode=0o700);state=out/'state';state.mkdir(mode=0o700)
for name in ['build-home','build-tmp']:(out/name).mkdir(mode=0o700)
files=['tools/test-voice-host-process','examples/voice_host_process.rs','src/lib.rs','src/voice_host.rs','src/voice_host/resource_discovery.rs','src/voice_context.rs','src/voice_worker.rs','src/voice_worker/stream.rs','src/voice_capture/mod.rs','src/voice_capture/resources.rs','src/voice_capture/profile_retirement.rs','src/voice_consent.rs','src/voice_transport.rs','src/browser_native_display.rs','src/desktop_browser_ipc.rs','ui/voice/consent-helper.cjs','ui/voice/consent-storage.cjs','ui/voice/native-consent.cjs','ui/voice/native-consent.sources.json','ui/voice/electron-runtime-44.10.1-linux-x64.json','ui/voice/electron-capture-main.cjs','ui/voice/electron-capture-preload.cjs','ui/voice/electron-capture-renderer.mjs','ui/voice/browser-capture-owner.mjs','ui/voice/browser-microphones.mjs','ui/voice/browser-microphones.sources.json','ui/js/NativePcmCapture.js','ui/browser/electron-private-fd.c','vendor/t3-protocol/UPSTREAM.json','Cargo.toml','Cargo.lock']
def digest(path):
 with path.open('rb')as data:return hashlib.file_digest(data,'sha256').hexdigest()
fence={name:digest(root/name)for name in files}
proof={'complete':False,'sourceSha256':fence,'imageId':image,'target':str(a.target),'scope':'Actual Host facade, original consent/capture and SDK with explicit synthetic microphone/private loopback HTTP; no Qt/watch IPC or live microphone claim'}
def save(): (out/'result.json').write_text(json.dumps(proof,indent=2)+'\n')
save()
base=[*podman,'run','--rm','--pull=never','--http-proxy=false','--read-only','--network=none','--userns=keep-id','--user',f'{os.getuid()}:{os.getgid()}','--cap-drop=ALL','--security-opt=no-new-privileges','--pids-limit=64','--memory=1g','--ulimit=core=0:0','-v','/usr:/usr:ro','-v',f'{root}:/repo:ro','-v',f'{source}:/source:rw','-v',f'{out}/build-home:/build-home:rw','-v',f'{out}/build-tmp:/build-tmp:rw','--env','HOME=/build-home','--env','TMPDIR=/build-tmp',image]
env={**os.environ,'CARGO_TARGET_DIR':str(a.target),'CARGO_BUILD_JOBS':'2','CARGO_INCREMENTAL':'0'}
cargo=shutil.which('cargo')or str(Path.home()/'.cargo/bin/cargo')
try:
 with Path('/var/tmp/o3-build/o3-parity-compile.lock').open('a')as lock:
  fcntl.flock(lock,fcntl.LOCK_EX)
  with(out/'compile.jsonl').open('w')as stdout,(out/'compile.log').open('w')as stderr:r=subprocess.run([cargo,'build','--locked','--offline','--example','voice_host_process','--message-format=json'],cwd=root,env=env,stdout=stdout,stderr=stderr)
  proof['buildExit']=r.returncode;save()
  if r.returncode:raise RuntimeError('Example compilation failed')
  rows=[json.loads(line)for line in(out/'compile.jsonl').read_text().splitlines()]
  binaries=[Path(row['executable'])for row in rows if row.get('executable')and row.get('target',{}).get('name')=='voice_host_process'and row['target']['kind']==['example']];assert len(binaries)==1
  binary=source/'host-check'
  original_fd=os.open(binaries[0],os.O_RDONLY|os.O_NOFOLLOW)
  with os.fdopen(original_fd,'rb')as original,binary.open('xb')as target:
   before=os.fstat(original.fileno());assert stat.S_ISREG(before.st_mode)
   while data:=original.read(1024*1024):target.write(data)
   after=os.fstat(original.fileno());assert(before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns)==(after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns)
  binary.chmod(0o500);proof['binarySha256']=digest(binary);proof['binaryBytes']=binary.stat().st_size
  with(out/'strict.log').open('w')as log:r=subprocess.run([cargo,'clippy','--locked','--offline','--example','voice_host_process','--','-D','warnings'],cwd=root,env=env,stdout=log,stderr=subprocess.STDOUT)
  proof['strictExit']=r.returncode;save()
  if r.returncode:raise RuntimeError('Directed example strict check failed')
  with(out/'addon.log').open('w')as log:r=subprocess.run([*base,'/usr/bin/cc','-shared','-fPIC','-O2','-Wall','-Wextra','-Werror','-I/usr/include/node','/repo/ui/browser/electron-private-fd.c','-o','/source/electron-private-fd.node'],stdout=log,stderr=subprocess.STDOUT,timeout=60)
  proof['addonExit']=r.returncode;save()
  if r.returncode:raise RuntimeError('Private descriptor addon compilation failed')
 (source/'electron-private-fd.node').chmod(0o500)
 command=[*podman,'run','--rm','--init','--pull=never','--http-proxy=false','--read-only','--network=none','--userns=keep-id','--user',f'{os.getuid()}:{os.getgid()}','--cap-drop=ALL','--security-opt=no-new-privileges','--security-opt=seccomp=unconfined','--memory=2g','--pids-limit=256','--shm-size=256m','--ulimit=core=0:0','--tmpfs','/tmp:rw,exec,size=128m,mode=1777','--tmpfs','/run:rw,size=32m','-v','/usr:/usr:ro','-v','/etc/fonts:/etc/fonts:ro','-v',f'{a.runtime.resolve()}:/electron:ro','-v',f'{source}:/source:ro','-v',f'{state}:/state:rw','--env','HOME=/state',image,'/source/host-check']
 with(out/'runtime.json').open('w')as stdout,(out/'runtime.log').open('w')as stderr:r=subprocess.run(command,stdout=stdout,stderr=stderr,timeout=120)
 proof['runtimeExit']=r.returncode
 assert all(digest(root/name)==expected for name,expected in fence.items())
 if r.returncode:raise RuntimeError('Actual Host runtime failed')
 proof['receipt']=json.loads((out/'runtime.json').read_text());proof['complete']=True;proof['exit']=0
except Exception as error:
 proof['exit']=1;proof['failure']=str(error)
finally:save();print(out)
raise SystemExit(proof['exit'])
