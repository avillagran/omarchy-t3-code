#!/usr/bin/env python3
"""Exercise the actual original browser audio graph with a synthetic device only."""
import argparse,hashlib,json,os,pathlib,subprocess,tempfile
p=argparse.ArgumentParser(description=__doc__);p.add_argument('--runtime',required=True,type=pathlib.Path);a=p.parse_args()
root=pathlib.Path(__file__).resolve().parent.parent
assert subprocess.check_output(['podman','--remote=false','info','--format','{{.Host.Security.Rootless}}'],text=True).strip()=='true'
runtime=a.runtime.resolve();manifest=json.loads((root/'ui/voice/electron-runtime-44.10.1-linux-x64.json').read_text())
assert manifest['version']=='44.10.1'and manifest['archiveSha256']=='2be868b71b0aa71f30e6b5567a106a35a049385e963183c074aad1975ead5167'
out=pathlib.Path(tempfile.mkdtemp(prefix='native-pcm-browser-',dir=os.environ.get('O3_SPEECH_EVIDENCE_ROOT','/var/tmp')));out.chmod(0o700)
source=out/'source';source.mkdir(mode=0o700);state=out/'state';state.mkdir(mode=0o700)
files=['tools/test-native-pcm-browser','tools/fixtures/pcm-browser-main.cjs','tools/fixtures/pcm-browser-preload.cjs','tools/fixtures/pcm-browser-driver.mjs','tools/fixtures/pcm-browser.py','ui/voice/browser-capture-owner.mjs','ui/js/NativePcmCapture.js','ui/js/NativePcmCapture.sources.json','ui/voice/electron-runtime-44.10.1-linux-x64.json'];fence={}
for name in files:
 data=(root/name).read_bytes();fence[name]=hashlib.sha256(data).hexdigest();target=source/pathlib.Path(name).name;target.write_bytes(data);target.chmod(0o400)
meta=json.loads((source/'NativePcmCapture.sources.json').read_text());assert meta['outputSha256']==fence['ui/js/NativePcmCapture.js']
(source/'runtime.json').write_text(json.dumps(manifest)+'\n')
command=['podman','--remote=false','run','--rm','--pull=never','--http-proxy=false','--timeout=70','--read-only','--network=none','--userns=keep-id','--user',f'{os.getuid()}:{os.getgid()}','--cap-drop=ALL','--security-opt=no-new-privileges','--security-opt=seccomp=unconfined','--ulimit=core=0:0','--memory=2g','--pids-limit=256','--shm-size=256m','--tmpfs','/tmp:rw,exec,size=128m,mode=1777','--tmpfs','/run:rw,size=32m','-v','/usr:/usr:ro','-v','/etc/fonts:/etc/fonts:ro','-v',f'{runtime}:/electron:ro','-v',f'{source}:/source:ro','-v',f'{state}:/state:rw','docker.io/library/archlinux:latest','python3','/source/pcm-browser.py']
with(out/'runtime.log').open('w')as log:result=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,timeout=85)
proof={'exit':result.returncode,'sourceSha256':fence,'runtimeArchiveSha256':manifest['archiveSha256'],'scope':'Actual Chromium getUserMedia/AudioContext/AudioWorklet with synthetic device, complete original capture resource and real renderer owner. No host microphone, consent UI, server transport or public activation acceptance.'}
receipt=state/'browser.json'
if receipt.is_file():proof['receipt']=json.loads(receipt.read_text())
if result.returncode==0:assert len(proof['receipt']['result']['cases'])==7
assert all(hashlib.sha256((root/name).read_bytes()).hexdigest()==digest for name,digest in fence.items()),'Source changed during probe'
for row in manifest['files']:
 path=runtime/row['path'];assert path.is_file()and not path.is_symlink()
 with path.open('rb')as file:assert hashlib.file_digest(file,'sha256').hexdigest()==row['sha256'],'Pinned runtime changed during probe'
(out/'result.json').write_text(json.dumps(proof,indent=2)+'\n');print(out);raise SystemExit(proof['exit'])
