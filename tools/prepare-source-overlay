#!/usr/bin/env python3
"""Build every overlay asset in a retained checkout before installation changes."""
import argparse
import json
import os
from pathlib import Path
import re
import runpy
import subprocess
import sys
import native_voice_bundle as voice

OVERLAY = runpy.run_path(str(voice.ROOT / 'tools/install-native-overlay'))
GENERATED_TRACKED = {'licenses/third-party-licenses.json',
    'licenses/third-party-licenses.sources.json', 'ui/js/NativeLicenses.js',
    'ui/js/NativeLicenses.sources.json'}


def prepare_source(repo, expected_commit, destination, builder=None):
    repo = voice.directory(repo)
    voice.directory(destination.parent, private=True)
    if destination.exists() or destination.is_symlink():
        raise ValueError('The source build destination must be absent')
    if not re.fullmatch('[0-9a-f]{40}|[0-9a-f]{64}', expected_commit):
        raise ValueError('An exact source build commit is required')
    actual = OVERLAY['git'](repo, 'rev-parse', '--verify', expected_commit + '^{commit}').stdout.decode().strip()
    if actual != expected_commit:
        raise ValueError('Source build commit changed')
    # Clone only tracked source, never active binaries, runtime copies or caches.
    OVERLAY['git'](repo, 'clone', '--no-hardlinks', '--no-checkout', '--local',
        '--', str(repo), str(destination))
    destination = voice.directory(destination)
    OVERLAY['git'](destination, 'checkout', '--detach', expected_commit)
    OVERLAY['clean_tracked'](destination)
    environment = {key: value for key, value in os.environ.items() if not key.startswith('GIT_')}
    environment.update(GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL='/dev/null',
        GIT_CONFIG_COUNT='3', GIT_CONFIG_KEY_0='core.hooksPath', GIT_CONFIG_VALUE_0='/dev/null',
        GIT_CONFIG_KEY_1='core.fsmonitor', GIT_CONFIG_VALUE_1='false',
        GIT_CONFIG_KEY_2='core.untrackedCache', GIT_CONFIG_VALUE_2='false')
    target = Path(environment.get('CARGO_TARGET_DIR', str(repo / 'target')))
    if not target.is_absolute():
        target = repo / target
    environment['CARGO_TARGET_DIR'] = str(target)
    command = [str(destination / 'bin/build-client')]
    if builder is None:
        subprocess.run(command, cwd=destination, env=environment, stdout=sys.stderr, check=True)
    else:
        # Unit fixtures explicitly substitute a bounded synthetic asset builder.
        builder(command, destination, environment)
    if OVERLAY['head'](destination) != expected_commit:
        raise ValueError('The isolated source revision changed during the build')
    if OVERLAY['git'](destination, 'diff', '--cached', '--quiet', '--no-ext-diff',
            '--no-textconv', check=False).returncode != 0:
        raise ValueError('The isolated source index changed during the build')
    changed = {os.fsdecode(name) for name in OVERLAY['git'](destination,
        'diff', '--no-ext-diff', '--no-textconv', '--name-only', '-z', '--').stdout.split(b'\0') if name}
    if not changed <= GENERATED_TRACKED:
        raise ValueError('Unexpected tracked source changes during the isolated build')
    # These four license outputs are deliberately regenerated by the original
    # builder for the selected compiler/architecture and embedded into the binary.
    for name in changed:
        file, _, _ = voice.regular(destination / name, immutable=False)
        file.close()
    for name in OVERLAY['ASSETS']:
        file, _, _ = voice.regular(destination / name, immutable=False)
        file.close()
    with (destination / 'COMMIT').open('x') as output:
        output.write(expected_commit + '\n')
    with (destination / 'BUILD-INFO').open('x') as output:
        output.write('sourceRevision=' + expected_commit + '\n')
    bundle = destination / 'bin/native-voice'
    has_bundle = bundle.exists() or bundle.is_symlink()
    if has_bundle:
        voice.verify(voice.directory(bundle, private=True))
    return {'sourceRevision': expected_commit, 'stage': str(destination),
        'assets': len(OVERLAY['ASSETS']), 'bundle': str(bundle) if has_bundle else None,
        'cargoTarget': str(target), 'generatedLicenseOutputs': sorted(changed)}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repo', type=Path, required=True)
    parser.add_argument('--expected-commit', required=True)
    parser.add_argument('--destination', type=Path, required=True)
    arguments = parser.parse_args()
    print(json.dumps(prepare_source(arguments.repo, arguments.expected_commit,
        arguments.destination)))


if __name__ == '__main__':
    main()
