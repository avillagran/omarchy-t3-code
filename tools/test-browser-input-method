 keyboard=subprocess.Popen(['wtype','-k','Shift_L','-s','20000'],env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
 result=subprocess.run(['/fixture/proof'],env=env,capture_output=True,text=True,timeout=15);print(result.stdout);print(result.stderr);assert result.returncode==0,result.returncode;assert 'BROWSER_QT_INPUT_METHOD_PASS' in result.stdout
