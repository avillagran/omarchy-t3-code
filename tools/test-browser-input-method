qml=out/'qml/O3/Browser';qml.mkdir(parents=True);(qml/'qmldir').write_bytes((root/'native/browser/qmldir').read_bytes())
build_code="import os,pathlib,resource,subprocess,sys\nfrom types import SimpleNamespace\nassert resource.getrlimit(resource.RLIMIT_CORE)==(0,0)\nout=pathlib.Path('/fixture');qml=out/'qml/O3/Browser';log=sys.stdout\noptions=SimpleNamespace(compositor_ime=os.environ.get('O3_COMPILE_COMPOSITOR_IME')=='1')\nmoc=subprocess.check_output(['pkg-config','--variable=libexecdir','Qt6Core'],text=True).strip()+'/moc'\nfor source,target in [('browserinputitem.h','moc_browserinputitem.cpp'),('clipboardplatform.h','moc_clipboardplatform.cpp'),('plugin.cpp','plugin.moc')]:subprocess.run([moc,str(out/source),'-o',str(out/target)],check=True,stdout=log,stderr=subprocess.STDOUT)\nflags=subprocess.check_output(['pkg-config','--cflags','--libs','Qt6Quick','Qt6Qml','Qt6Gui','wayland-client','xcb','xcb-xfixes','xcb-res'],text=True).split()\nsubprocess.run(['c++','-std=c++17','-fPIC','-Wall','-Wextra','-Werror','-shared',*[str(out/name) for name in ['clipboardplatform.cpp','clipboardcohort.cpp','plugin.cpp','moc_clipboardplatform.cpp','moc_browserinputitem.cpp']],'-I'+str(out),'-o',str(qml/'libo3browserplatform.so'),*flags],check=True,stdout=log,stderr=subprocess.STDOUT)\nsubprocess.run(['c++','-std=c++17','-fPIC','-Wall','-Wextra','-Werror',str(out/'proof.cpp'),'-o',str(out/'proof'),*flags],check=True,stdout=log,stderr=subprocess.STDOUT)\nif options.compositor_ime:\n for mode,name in [('client-header','input-method-client.h'),('private-code','input-method-protocol.c')]:subprocess.run(['wayland-scanner',mode,str(out/'input-method-unstable-v2.xml'),str(out/name)],check=True,stdout=log,stderr=subprocess.STDOUT)\n wayland=subprocess.check_output(['pkg-config','--cflags','--libs','wayland-client'],text=True).split()\n subprocess.run(['cc','-std=c11','-Wall','-Wextra','-Werror',str(out/'wayland-input-method-peer.c'),str(out/'input-method-protocol.c'),'-o',str(out/'input-method-peer'),*wayland],check=True,stdout=log,stderr=subprocess.STDOUT)\n"
build_args=['podman','run','--rm','--pull=never','--read-only','--network=none','--userns=keep-id','--cap-drop=ALL','--security-opt=no-new-privileges','--ulimit=core=0:0','--pids-limit=64','--memory=512m','--tmpfs','/tmp:rw,size=64m,mode=1777','-v','/usr:/usr:ro','-v',str(out)+':/fixture:rw','--env','HOME=/tmp','--env','O3_COMPILE_COMPOSITOR_IME='+('1' if options.compositor_ime else '0'),'docker.io/library/archlinux:latest','python3','-c',build_code]
