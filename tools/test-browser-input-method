 if keyboard is not None and keyboard.poll() is None:keyboard.terminate();keyboard.wait(timeout=3)
 display.terminate();display.wait(timeout=3);log.close()
''']
if options.compositor_ime:args[3:3]=['--env','O3_TEST_COMPOSITOR_IME=1']
with (out/'runtime.log').open('w') as log:result=subprocess.run(args,stdout=log,stderr=subprocess.STDOUT,timeout=25)
