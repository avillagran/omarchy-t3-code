 for name in ['wayland-input-method-peer.c','input-method-unstable-v2.xml','input-method-unstable-v2.source.json']:(out/name).write_bytes((root/'tools/fixtures'/name).read_bytes())
 reference=json.loads((out/'input-method-unstable-v2.source.json').read_text());assert hashlib.sha256((out/'input-method-unstable-v2.xml').read_bytes()).hexdigest()==reference['sha256']
