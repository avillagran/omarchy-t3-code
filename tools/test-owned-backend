#!/usr/bin/env python3
"""Run reviewed owned-supervisor cases with immutable binaries in private Podman."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import stat
import subprocess
import tempfile
import uuid
from runtime_artifacts import snapshot

parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('--server-fixture',type=Path,required=True)
parser.add_argument('--expected-sha256',required=True)
options=parser.parse_args()
fixture=options.server_fixture.resolve()
if not fixture.is_file() or not fixture.stat().st_mode & 0o111:
    raise SystemExit('Server fixture must be an explicit executable file')
if len(options.expected_sha256)!=64 or any(c not in '0123456789abcdef' for c in options.expected_sha256):
    raise SystemExit('An exact lowercase SHA-256 is required')
if subprocess.check_output(['podman','info','--format','{{.Host.Security.Rootless}}'],text=True).strip()!='true':
    raise SystemExit('Rootless Podman is required')
root=Path(__file__).resolve().parent.parent
out=Path(tempfile.mkdtemp(prefix='o3-owned-proof-',dir=os.environ.get('O3_TEST_ARTIFACT_ROOT','/var/tmp')))
print('Owned supervisor evidence: '+str(out),flush=True)
server=out/'server-fixture'
source_fd=os.open(fixture,os.O_RDONLY|os.O_NOFOLLOW|os.O_CLOEXEC)
with os.fdopen(source_fd,'rb') as source,server.open('xb') as target:
    if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
        raise SystemExit('Server fixture must be a regular file')
    while data:=source.read(1024*1024): target.write(data)
server.chmod(0o500)
with server.open('rb') as source: server_hash=hashlib.file_digest(source,'sha256').hexdigest()
if server_hash!=options.expected_sha256: raise SystemExit('Server fixture SHA-256 mismatch; nothing executed')
(out/'server-artifact.json').write_text(json.dumps({'sha256':server_hash,'bytes':server.stat().st_size})+'\n')
lock=Path(os.environ.get('O3_BUILD_LOCK','/var/tmp/o3-build/o3-parity-compile.lock'))
lock.parent.mkdir(parents=True,exist_ok=True)
with lock.open('a') as compile_lock:
    fcntl.flock(compile_lock.fileno(),fcntl.LOCK_EX)
    env=dict(os.environ,CARGO_BUILD_JOBS='2')
    command=['cargo','test','--locked','--offline','--lib','--test','owned_backend','--no-run','--message-format=json']
    result=subprocess.run(command,cwd=root,env=env,stdout=(out/'compile.jsonl').open('w'),stderr=(out/'compile.log').open('w'))
    if result.returncode: raise SystemExit(result.returncode)
    items=[json.loads(line) for line in (out/'compile.jsonl').read_text().splitlines()]
    binaries=[(item['target']['name'],item['executable']) for item in items if item.get('executable') and item.get('profile',{}).get('test')]
    if len(binaries)!=2: raise SystemExit('Expected only the reviewed library and owned-backend target')
    debug=Path(binaries[0][1]).parent.parent
    runtime=debug.resolve().parent/('test-runtime-owned-'+uuid.uuid4().hex)
    records=snapshot(debug,[Path(binary) for _,binary in binaries],runtime)
    (out/'runtime-artifacts.json').write_text(json.dumps({'directory':str(runtime),'files':records},indent=2)+'\n')
args=['podman','run','--rm','--pull=never','--userns=keep-id','--user',str(os.getuid())+':'+str(os.getgid()),'--read-only','--tmpfs','/tmp:rw,exec,size=1g,mode=1777','--tmpfs','/var/tmp:rw,size=1g,mode=1777','--network=none','--cap-drop=ALL','--security-opt=no-new-privileges','--pids-limit=256','--memory=3g','-v',str(runtime)+':'+str(debug)+':ro','-v','/usr:/usr:ro','-v',str(root)+':'+str(root)+':ro','-v',str(server)+':/fixture/o3-server:ro','--env','HOME=/tmp/home','--env','TMPDIR=/tmp','docker.io/library/archlinux:latest','python3','-c',r'''
import os,json,subprocess,sys
os.mkdir('/tmp/home',0o700)
for name,binary in json.loads(sys.argv[1]):
    args=[binary,'--test-threads=1']
    if name!='owned_backend': args.insert(1,'owned_backend::')
    result=subprocess.run(args,timeout=60)
    if result.returncode: sys.exit(result.returncode)
''',json.dumps(binaries)]
with (out/'runtime.log').open('w') as output:
    result=subprocess.run(args,stdout=output,stderr=subprocess.STDOUT,timeout=150)
(out/'result.json').write_text(json.dumps({'returncode':result.returncode,'binaries':binaries})+'\n')
raise SystemExit(result.returncode)
