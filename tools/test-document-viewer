#!/bin/bash
# Build/test-only Node orchestration; runtime backend is Rust and frontend Qt/QML.
set -eu
cd -- "$(dirname -- "$0")/.."
node <<'NODE_DOCUMENT_TEST'
const fs=require('fs'),{spawn,execFileSync}=require('child_process'),assert=require('node:assert/strict'),crypto=require('crypto');
const dir=fs.mkdtempSync('/tmp/t3-document-test-');fs.chmodSync(dir,0o700);
const data={offscreen:true,frameDirectory:dir,width:640,height:400,html:true,title:'Document verification',baseUrl:'about:blank',contents:'<style>body{margin:0;background:#203040;color:#abcdef}button{position:absolute;left:10px;top:10px;width:150px;height:70px}</style><button onclick="this.innerText=\'Clicked\';this.style.background=\'green\';setTimeout(()=>this.style.background=\'blue\',900)">Click</button><p style="position:absolute;top:120px">Inside the panel</p>',theme:{appearance:'dark',variables:{'--background':'#111111','--foreground':'#bbbbbb','--card':'#191919','--secondary':'#242424','--accent':'#e99700','--font-sans':'sans-serif','--border':'#444444'}}};
const p=spawn('bin/omarchy-t3-client',['document-render'],{env:{...process.env,QT_QPA_PLATFORM:'offscreen',QT_QUICK_BACKEND:'software',QTWEBENGINE_CHROMIUM_FLAGS:'--disable-gpu',T3_DOCUMENT_VERIFY:'1'},stdio:['pipe','pipe','pipe']});
const payload=Buffer.from(JSON.stringify(data)),header=Buffer.alloc(8);header.writeBigUInt64BE(BigInt(payload.length));p.stdin.write(header);p.stdin.write(payload);
let out='',log='',latest=null,frames=0,clip='',exited=false,exitCode=null;
const sleep=ms=>new Promise(resolve=>setTimeout(resolve,ms));
async function waitFor(check,ms=6000){const until=Date.now()+ms;while(Date.now()<until){if(check())return;assert(!exited,'renderer exited early: '+log);await sleep(40)}throw Error('renderer timeout: '+log)}
function send(event){p.stdin.write(JSON.stringify(event)+'\n')}
function hash(){assert(latest,'no frame');return crypto.createHash('sha256').update(fs.readFileSync(dir+'/'+latest.frame)).digest('hex')}
p.stderr.on('data',v=>log+=v);p.stdout.on('data',v=>{out+=v;let n;while((n=out.indexOf('\n'))>=0){let line=out.slice(0,n);out=out.slice(n+1);if(!line.startsWith('{'))continue;let f=JSON.parse(line);if(f.frame){latest=f;frames++}if(f.clipboard!==undefined)clip=f.clipboard;}});
p.on('exit',code=>{exited=true;exitCode=code});
(async()=>{try{
 await waitFor(()=>log.includes('DOCUMENT_VERIFY {')&&latest);const m=log.match(/DOCUMENT_VERIFY (\{.*\})/);assert(m,log);const r=JSON.parse(m[1]);assert.equal(r.status.background,'rgb(32, 48, 64)');assert.equal(r.status.foreground,'rgb(171, 205, 239)');assert.equal(r.status.accent,'#e99700');assert.equal(r.status.sandboxed,true);assert.equal(r.sandbox,'allow-scripts allow-forms');
 const clients=JSON.parse(execFileSync('hyprctl',['clients','-j'],{encoding:'utf8'}));assert(!clients.some(c=>c.pid===p.pid),'renderer must not create a desktop window');
 const before=hash();send({type:'press',x:70,y:40,button:1,buttons:1,modifiers:0});send({type:'release',x:70,y:40,button:1,buttons:0,modifiers:0});await waitFor(()=>hash()!==before);await sleep(400);const clicked=hash();await waitFor(()=>hash()!==clicked);await sleep(400);const idle=frames;await sleep(400);assert.equal(frames,idle,'idle page must not capture continuously');
 send({type:'key',key:65,text:'a',modifiers:0x10000000});await sleep(120);send({type:'key',key:67,text:'c',modifiers:0x10000000});await waitFor(()=>clip.includes('Inside the panel'));
 send({type:'resize',width:740,height:420});send({type:'zoom',value:1.25});await waitFor(()=>latest.width===740&&latest.height===420);assert(frames>=3);
 if(process.env.T3_DOCUMENT_TEST_CAPTURE)fs.copyFileSync(dir+'/'+latest.frame,process.env.T3_DOCUMENT_TEST_CAPTURE);send({type:'close'});await waitFor(()=>exited);assert.equal(exitCode,0);console.log('DOCUMENT_VIEWER_PASS: embedded transport, real HTML click, delayed repaint, no idle captures, copy, resize/zoom, authored CSS, sandbox and no desktop window');
 }catch(error){console.error(error);process.exitCode=1}finally{if(!exited){send({type:'close'});await sleep(700);if(!exited)p.kill()}fs.rmSync(dir,{recursive:true,force:true});}})();
NODE_DOCUMENT_TEST
