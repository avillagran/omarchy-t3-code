#!/usr/bin/env bash
# Build a native overlay for exactly the checked-out commit.
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
[[ -z $(git status --porcelain --untracked-files=normal) ]] || { echo 'Commit changes before packaging.' >&2; exit 1; }
arch=$(uname -m)
case "$arch" in aarch64|x86_64) ;; *) echo "Unsupported architecture: $arch" >&2; exit 1;; esac
commit=$(git rev-parse HEAD)
bin/build-client
[[ -s bin/libt3-document.so ]]
mkdir -p dist
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
mkdir "$stage/bin"
install -m755 bin/omarchy-t3-client bin/libt3-document.so "$stage/bin/"
printf '%s\n' "$commit" > "$stage/COMMIT"
printf 'architecture=%s\nqt=%s\nglibc=%s\nrust=%s\n' "$arch" "$(pkg-config --modversion Qt6Core)" "$(getconf GNU_LIBC_VERSION)" "$(rustc --version)" > "$stage/BUILD-INFO"
asset="omarchy-t3-code-linux-$arch.tar.gz"
tar -czf "dist/$asset" -C "$stage" bin COMMIT BUILD-INFO
(cd dist && sha256sum "$asset" > "$asset.sha256")
printf 'Packaged %s (%s)\n' "$asset" "$commit"
