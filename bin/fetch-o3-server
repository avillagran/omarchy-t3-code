#!/usr/bin/env bash
# Install the pinned O3 Server as ~/.local/share/o3-server/bin/o3-server. Verified
# against both the pinned hash and the release's SHA256SUMS; never uses PATH.
# Exits non-zero without touching an existing copy.
set -euo pipefail
plugin_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
pin=$plugin_dir/integrations/o3-server/release
field() { sed -n "s/^$1=\([A-Za-z0-9._-]*\)$/\1/p" "$pin" | head -1; }
version=$(field version)
arch=$(uname -m)
expected=$(field "sha256_$arch")
[[ $version =~ ^v[0-9][A-Za-z0-9._-]*$ ]] || { echo 'o3-server: invalid pinned version' >&2; exit 1; }
[[ $expected =~ ^[0-9a-f]{64}$ ]] || { echo "o3-server: no pinned build for $arch" >&2; exit 1; }
target=${O3_SERVER_HOME:-$HOME/.local/share/o3-server}/bin/o3-server
if [[ -x $target && $("$target" --version 2>/dev/null) == "o3-server ${version#v}" ]]; then exit 0; fi
work=$(mktemp -d)
cleanup() {
  # Only the explicitly downloaded/extracted files belong to this operation.
  rm -f -- "$work/SHA256SUMS" || true
  if [[ -n ${asset:-} ]]; then rm -f -- "$work/$asset" || true; fi
  unpacked=$work/unpacked/o3-server-$version-$arch-linux
  if [[ ! -L "$work/unpacked" && ! -L "$unpacked" && -d "$unpacked" ]]; then
    rm -f -- "$unpacked/o3-server" || true
    rmdir -- "$unpacked" 2>/dev/null || true
  fi
  rmdir -- "$work/unpacked" "$work" 2>/dev/null || true
}
trap cleanup EXIT
asset="o3-server-$version-$arch-linux.tar.gz"
base_url=${OT3_O3_SERVER_RELEASE_URL:-https://github.com/avillagran/o3-server/releases/download}/$version
curl -fsSL "$base_url/$asset" -o "$work/$asset"
curl -fsSL "$base_url/SHA256SUMS" -o "$work/SHA256SUMS"
[[ $(sed -n "s/^\([0-9a-f]\{64\}\)  $asset$/\1/p" "$work/SHA256SUMS") == "$expected" ]] || { echo 'o3-server: SHA256SUMS does not match the pinned hash' >&2; exit 1; }
[[ $(sha256sum "$work/$asset" | cut -d' ' -f1) == "$expected" ]] || { echo 'o3-server: checksum failed' >&2; exit 1; }
mkdir "$work/unpacked"
tar -xzf "$work/$asset" -C "$work/unpacked" "o3-server-$version-$arch-linux/o3-server"
binary=$work/unpacked/o3-server-$version-$arch-linux/o3-server
# Requires glibc 2.39 or newer; refuse a binary that cannot load here.
if ldd "$binary" 2>&1 | grep -q 'not found'; then echo 'o3-server: runtime libraries do not match this system' >&2; exit 1; fi
[[ $("$binary" --version 2>/dev/null) == "o3-server ${version#v}" ]] || { echo 'o3-server: the binary does not run on this system' >&2; exit 1; }
mkdir -p "$(dirname "$target")"
install -m755 "$binary" "$target.new"
mv -f -- "$target.new" "$target"
printf 'Installed O3 Server %s.\n' "$version"
