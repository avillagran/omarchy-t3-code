#!/usr/bin/env bash
# OpenSSH reads the answer directly from stdout. Never persist it or trace this helper.
set -eu
prompt=${1:-SSH}
prompt=${prompt//&/\&amp;}
prompt=${prompt//</\&lt;}
prompt=${prompt//>/\&gt;}
if command -v zenity >/dev/null 2>&1; then
  exec zenity --entry --hide-text --title='O3 · SSH' --timeout=110 --text="$prompt"
fi
exit 1
